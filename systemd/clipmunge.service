; Service template. Nix and make install replace ExecStart.
; For manual installation, set the binary path and copy to
; ~/.config/systemd/user/clipmunge.service. Create the config, then run:
;   systemctl --user daemon-reload
;   systemctl --user enable --now clipmunge

[Unit]
Description=Rewrite the Wayland clipboard according to Lua rules
Documentation=man:clipmunge(1) man:clipmunge(5)
; Adjust the session target here and in WantedBy if needed.
PartOf=graphical-session.target
After=graphical-session.target
; Require a Wayland session environment.
ConditionEnvironment=WAYLAND_DISPLAY
; StartLimit* belong to [Unit]; systemd ignores them in [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
; READY=1 is sent after the config loads and the compositor connects.
Type=notify
; Limit startup wait for an unresponsive compositor.
TimeoutStartSec=30
; Installers replace this path; cargo install uses ~/.cargo/bin/clipmunge.
ExecStart=%h/.local/bin/clipmunge

; Limit repeated failures with StartLimitBurst above.
Restart=on-failure
RestartSec=3

; PrivateTmp hides the session /tmp; keep config files outside it.
NoNewPrivileges=yes
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
; Plain Lua 5.4, no JIT, so nothing needs writable-executable pages.
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical-session.target

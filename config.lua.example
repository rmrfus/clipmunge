-- Copy to ~/.config/clipmunge/config.lua (or $XDG_CONFIG_HOME/clipmunge/config.lua).
-- Rules run in declaration order; the first valid replacement wins.
-- Handlers receive the incoming selection followed by regex capture groups.
-- Return nil to decline, a string for plain text, or a MIME-keyed table.
-- See man 5 clipmunge for the full API.
--
-- Only install trusted configs: notify_command can run a program.

-- Skip offers advertising these MIME types before reading. This replaces
-- the default list; an empty table disables the check.
-- clipmunge.settings { secret_mimes = { "x-kde-passwordManagerHint" } }

-- Link ticket IDs while preserving plain text. Skip selections with readable
-- rich content. Replace these URLs with your trackers.
local trackers = {
  BUG  = "https://bugs.example.com/",
  TASK = "https://tasks.example.com/",
}

clipmunge.rule {
  name = "tickets",
  match = [[^([A-Z]+)-(\d+)$]],
  when = "plain-only",
  handler = function(_, kind, number)
    local base = trackers[kind]
    if not base then
      return nil
    end
    local id = kind .. "-" .. number
    return clipmunge.link(base .. id, id)
  end,
}

-- Remove tracking parameters using clipmunge.url.default_junk.
-- Pass a second argument to strip_params to use your own list.
clipmunge.rule {
  name = "detrack",
  match = [[^(https?://\S+)$]],
  handler = function(_, url)
    local clean, dropped = clipmunge.url.strip_params(url)
    -- Try the next rule if the URL is already clean.
    if not clean then return nil end
    local out = clipmunge.link(clean, clean)
    out.notify = "Dropped " .. table.concat(dropped, ", ")
    return out
  end,
}

-- Alternative: clean the source URL supplied by the browser.
-- Uncomment to use instead of the detrack rule above.
--
-- clipmunge.rule {

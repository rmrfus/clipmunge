--   match = [[^\S+$]],
--   handler = function(incoming)
--     local href = incoming:get("chromium/x-source-url")
--     if not href then return nil end
--     local clean = clipmunge.url.strip_params(href)
--     if not clean then return nil end
--     return clipmunge.link(clean, clean)
--   end,
-- }

-- Shorten Amazon URLs to the product path. A URL changed by detrack above
-- stops there; this rule runs only if earlier rules decline.
clipmunge.rule {
  name = "amazon",
  match = [[^https?://([^/]*amazon\.[^/]+)/(?:.*/)?(?:dp|gp/product|gp/aw/d)/([A-Z0-9]{10})]],
  handler = function(_, host, asin)
    return "https://" .. host .. "/dp/" .. asin
  end,
}

#!/usr/bin/env bash
# Run checks against the staged tree.
set -Eeuo pipefail

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

git checkout-index --all --prefix="$work/"
# Reuse the local build cache.
[[ -d target ]] && ln -s "$PWD/target" "$work/target"

cd "$work"
# Use the pinned development environment and committed lockfile.
nix develop "$OLDPWD" --command sh -c '
  set -e
  cargo fmt --all --check
  cargo clippy --all-targets --locked -- -D warnings
  cargo test --locked --quiet
  cargo deny check advisories sources
  cargo machete
'
